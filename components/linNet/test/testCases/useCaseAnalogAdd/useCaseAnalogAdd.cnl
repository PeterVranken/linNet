 * You should have received a copy of the GNU General Public License along
 * with this program. If not, see <http://www.gnu.org/licenses/>.
 */

U    U1  in1 gnd
U    U2  in2 gnd
     
R    R1  in1 op1 R1=1k
R    R2  in2 op1 R2=1/2*R1
R    R3  op1 out R3=4*R1
R    R4  k1  out R4=1/10*R1
C    C1  op1 k1  C1=100n
     
OP   OP  op1 gnd out

RES  MIMO U_out I_OP
PLOT G1   U_out U1
