/**
 * @file Tschebyscheff-tableValues.cnl
 * Test case for linNet.
 *
 * A 2nd-order LP filter, which can be computed by linNet and which can be
 * numerically computed by Octave or MATLAB. Two stages of this kind can
 * be put in series to realize a Butterworth or Tschebyscheff filter of
 * 4th order.
 *
 * The filter schematics and the device values have been taken from a
 * student internship report, Aktiver Tiefpass mit Operationsverstärker,
 * downloaded as http://www.geoid.ch/misc/labor/Versuch4-Aktiver-TP-OP.pdf
 * on Mar 5th, 2014.
 *
 * The netlist implements the filter stage shown in Figure 1.1 on page 1.
 * The chosen device values realize the first stage of the Tschebyscheff
 * low pass according to the table with theoretic values on page 8 of the
 * document.
 *
 * Copyright (C) 2014 Peter Vranken (mailto:Peter_Vranken@Yahoo.de)
 *
 * This program is free software: you can redistribute it and/or modify it
 * under the terms of the GNU General Public License as published by the
 * Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This program is distributed in the hope that it will be useful, but
 * WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
 * General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License along
 * with this program. If not, see <http://www.gnu.org/licenses/>.
 */

U Ue        in  gnd
DEF UA      out gnd

R R1        in  K1   R1=2.86k
R R2        K1  out  R2=9k
R R3        K1  K2   R3=6.2k

C C1        K2  out  C1=1n
C C2        K1  gnd  C2=25n

OP LF356N   K2  gnd     out

/* An additional load current at the output permitts to compute the output
   impedance. */
I IA        gnd out

PLOT        G   UA  Ue      LOG     50  10  20k
PLOT        Zi  Ue  I_Ue    LOG     50  0.1 20k
PLOT        Zo  UA  IA      LOG     50  0.1 20k