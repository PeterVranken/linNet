/**
 * @file Butterworth-schematics-Fig-2.1.cnl
 * Test case for linNet.
 *
 * A 4th-order LP filter, which can be computed by linNet and which can be
 * numerically computed by Octave or MATLAB. The device value are
 * configured such that the Octave default plots show Butterworth
 * characteristics and a cutoff frequency of 10 kHz.
 *
 * The filter schematics and the device values have been taken from a
 * student internship report, Aktiver Tiefpass mit Operationsverstärker,
 * downloaded as http://www.geoid.ch/misc/labor/Versuch4-Aktiver-TP-OP.pdf
 * on Mar 5th, 2014.
 *
 * There are different *.cnl files with identical netlist. Only the device
 * values are chosen differently. The PDF document proposes Butterworth
 * and Chebyshev filters and it makes the distinction between
 * theoretically calculated values and those of deliverable devices from
 * the standard series. The different netlist files implement all four
 * variants. 
 *
 * Here, we have the Butterworth low pass according to Figure 2.1 on
 * page 7 of the document.
 *
 * Copyright (C) 2014-2026 Peter Vranken (mailto:Peter_Vranken@Yahoo.de)
 *
 * This program is free software: you can redistribute it and/or modify it
 * under the terms of the GNU General Public License as published by the
 * Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This program is distributed in the hope that it will be useful, but
 * WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
 * General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License along
 * with this program. If not, see <http://www.gnu.org/licenses/>.
 */

U UE        in          gnd
DEF UE_2    out1in2     gnd
DEF UA1     out1in2     gnd
DEF UA      out         gnd

/* First stage */
R R1        in      K11             R1=2.2k
R R2        K11     out1in2         R2=6.8k
R R3        K11     K12             R3=5.4k

C C1        K12     out1in2         C1=1n
C C2        K11     gnd             C2=6.8n

OP LF356N_1 K12     gnd     out1in2

/* Second stage */
R R4        out1in2 K21             R4=1.2k
R R5        K21     out             R5=3.8k
R R6        K21     K22             R6=2k

C C3        K22     out             C3=1n
C C4        K21     gnd             C4=33n

OP LF356N_2 K22     gnd     out

PLOT G  UA  UE      LOG     250 10  20k
PLOT G1 UA1 UE      LOG     250 10  20k
PLOT G2 UA  UE_2    LOG     250 10  20k
