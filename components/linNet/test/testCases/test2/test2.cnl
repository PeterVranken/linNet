/* Same as test.cir plus an additional capacity, which couples input
   directly with output. This element makes the power of numerator and
   denominator of transfer function equal, so that a simple translation of
   the system into a Octave state space representation is impossible. A
   partial fraction decomposition is needed for that. */
U   U1  in1 gnd
U   U2  in2 gnd
R   R1  in1 K_l
R   R2  in2 K_l
L   L   K_l out
C   C   out K_rc
R   R3  K_rc gnd
C   C1  in1 out

DEF U_L K_l out
DEF U_C K_rc gnd
DEF U_LC K_l K_rc

RES cmpUlWithUrlc U_L U_K_l

/* See the dependency of voltage drop at L, at C and at L+C on the input
   voltage (while the other is assumed to be zero). */
PLOT U_L U_L U1 LOG 100 10.0 100e3
PLOT U_C U_C U1 LOG 100 10.0 100e3
PLOT U_LC U_LC U1 LOG 100 10.0 100e3