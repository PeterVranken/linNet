/* In- and output voltages */
U   Vin  kIn      gnd
DEF Vout kOpBMOut gnd

/* Top-left OP */
R  R4   kIn     kOpTLIn
R  R1   kOpTLIn kOpTLOut
C  C1   kOpTLIn kOpTLOut
OP OpTL kOpTLIn gnd      kOpTLOut

/* Top-mid OP */
R  R2   kOpTLOut kOpTMIn
C  C2   kOpTMIn  kOpTMOut
OP OpTM kOpTMIn  gnd      kOpTMOut

/* Top-right OP */
R  R5   kOpTMOut kOpTRIn
R  R6   kOpTRIn  kOpTRout
OP OpTR kOpTRIn  gnd      kOpTRout

/* Feed-back top-right to top-left OP */
R  R3   kOpTRout kOpTLIn

/* Bottom-mid OP */
R  R8   kOpTLOut kOpBMIn
R  R11  kOpBMIn  kOpBMOut
OP OpBM kOpBMIn  gnd      kOpBMOut

/* Wanted results */
PLOT G Vout Vin