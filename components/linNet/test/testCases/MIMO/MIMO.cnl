 * You should have received a copy of the GNU General Public License along
 * with this program. If not, see <http://www.gnu.org/licenses/>.
 */
 
/* This is the MI-part of MIMO: We have two input voltages. */
U   U1  in1 gnd
U   U2  in2 gnd

R   R1  in1 K_l
R   R2  in2 K_l
L   L   K_l out
C   C   out gnd

/* We make the voltage drop across the inductivity visible. */
DEF U_L K_l out

/* Plot the frequency response of the output in dependency of the first
   input, while the second input is pulled to ground. */ 
PLOT G_out_U1 U_out U1 LOG 10 10 20k
 
/* This is the MO-part of MIMO: We define the outputs of the system. */
RES MIMO U_out U_K_l U_L LIN 500 50 20k
